rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEnrolled(courseId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.enrolledCourseIds.hasAny([courseId]);
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isOwner(studentId);
      // Restrict created fields so a user cannot self-enroll via enrolledCourseIds
      allow create: if isAuthenticated() && request.auth.uid == studentId
        && request.resource.data.diff(resource).affectedKeys().hasOnly(['name', 'email', 'isVerified', 'enrolledCourseIds', 'telegramUserId', 'telegramUsername', 'createdAt', 'updatedAt'])
        && request.resource.data.enrolledCourseIds.size() == 0
        && request.resource.data.isVerified == false;
      allow update: if isOwner(studentId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'email', 'telegramUserId', 'telegramUsername', 'updatedAt']);
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if resource.data.status == "PUBLISHED" || isAdmin();
      allow create, update, delete: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if isAdmin() || isEnrolled(courseId);
        allow create, update, delete: if isAdmin();
      }
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || resource.data.studentId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || resource.data.studentId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true || isAdmin();
      // Only the author can create, and only with verified fields
      allow create: if isAuthenticated()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.approved == false
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow update, delete: if isAdmin();
    }

    match /meta/{doc} {
      // Admin dashboard stats cache is sensitive — do not make it world-readable
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}